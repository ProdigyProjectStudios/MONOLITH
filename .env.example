# Choose a random, URL-safe local database password before starting Compose.
DB_PASSWORD=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
HUBSPOT_TENANT=northstar
HUBSPOT_ACCESS_TOKEN=
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
HUBSPOT_REFRESH_TOKEN=
TENANT_TOKENS={}
WEB_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MONOLITH_ENV=development
# Optional JSON keyed by exact model name, with your USD rates per million tokens.
OPENAI_MODEL_PRICING_JSON=
# Register this callback in your HubSpot app; production deployments should use HTTPS.
HUBSPOT_REDIRECT_URI=
HUBSPOT_TOKEN_KEY=
HUBSPOT_CASE_PROPERTY=
